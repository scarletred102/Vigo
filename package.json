{
  "name": "vigo-browser",
  "version": "1.0.0",
  "description": "Vigo — The Browser Reimagined",
  "main": "main.js",
  "scripts": {
    "start": "node node_modules/electron/cli.js .",
    "dev": "node node_modules/electron/cli.js . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "benchmark": "node tests/benchmark.js"
  },
  "build": {
    "appId": "com.antigravity.vigo",
    "productName": "Vigo Browser",
    "files": [
      "**/*",
      "!tests/**",
      "!.agents/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "AntiGravity",
      "repo": "Vigo"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.8.3"
  },
  "author": "AntiGravity",
  "license": "MIT"
}