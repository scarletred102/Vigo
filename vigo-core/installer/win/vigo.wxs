<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copyright (c) 2025 Vigo Browser. All rights reserved.
  Proprietary and confidential. Unauthorized copying prohibited.

  Vigo Browser — Windows Installer (WiX v4)

  Build:
    wix build -o vigo-setup.msi vigo.wxs
    wix build -o vigo-setup.exe Bundle.wxs

  Prerequisites:
    - WiX Toolset v4 (dotnet tool install --global wix)
    - Vigo build output in $(var.BuildDir) (default: out\Release)
    - Code signing certificate (optional, applied post-build via signtool)
-->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!-- ── Product Definition ─────────────────────────────────── -->
  <Package
    Name="Vigo Browser"
    Manufacturer="Vigo Browser"
    Version="!(bind.FileVersion.VigoExe)"
    UpgradeCode="7B3F9A1E-4D2C-4E8F-B5A7-1C3D6E9F2A4B"
    Language="1033"
    Codepage="1252"
    InstallerVersion="500"
    Compressed="yes"
    Scope="perUser">

    <!-- InstallScope: perUser by default (no admin needed).
         Users can elevate to perMachine via custom action if desired. -->

    <SummaryInformation
      Description="Vigo Browser — Privacy-first, streaming-optimized desktop browser"
      Manufacturer="Vigo Browser" />

    <!-- ── Media ──────────────────────────────────────────── -->
    <Media Id="1" Cabinet="vigo.cab" EmbedCab="yes" CompressionLevel="high" />

    <!-- ── Upgrade Logic ──────────────────────────────────── -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of Vigo Browser is already installed."
      AllowSameVersionUpgrades="yes"
      Schedule="afterInstallInitialize" />

    <!-- ── Properties ─────────────────────────────────────── -->
    <Property Id="ARPPRODUCTICON" Value="vigo.ico" />
    <Property Id="ARPHELPLINK" Value="https://vigo-browser.com/help" />
    <Property Id="ARPURLINFOABOUT" Value="https://vigo-browser.com" />
    <Property Id="ARPURLUPDATEINFO" Value="https://vigo-browser.com/update" />

    <!-- ── Directory Structure ────────────────────────────── -->
    <Directory Id="TARGETDIR" Name="SourceDir">

      <!-- Per-user install: LocalAppData\Programs\Vigo Browser -->
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="Vigo Browser">

            <!-- Main binary -->
            <Component Id="MainExecutable" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
              <File Id="VigoExe"
                    Name="vigo.exe"
                    Source="$(var.BuildDir)\vigo.exe"
                    KeyPath="yes">

                <!-- File associations and protocol handlers would go here.
                     Default browser registration requires HKLM write (perMachine). -->
              </File>
            </Component>

            <!-- Chromium resources -->
            <Component Id="ChromiumResources" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
              <File Id="ResourcesPak"
                    Name="resources.pak"
                    Source="$(var.BuildDir)\resources.pak"
                    KeyPath="yes" />
            </Component>

            <Component Id="VigoResources" Guid="C3D4E5F6-A7B8-9012-CDEF-123456789012">
              <File Id="VigoPak"
                    Name="vigo_resources.pak"
                    Source="$(var.BuildDir)\vigo_resources.pak"
                    KeyPath="yes" />
            </Component>

            <!-- ICU data -->
            <Component Id="IcuData" Guid="D4E5F6A7-B8C9-0123-DEFA-234567890123">
              <File Id="IcuDat"
                    Name="icudtl.dat"
                    Source="$(var.BuildDir)\icudtl.dat"
                    KeyPath="yes" />
            </Component>

            <!-- V8 snapshot -->
            <Component Id="V8Snapshot" Guid="E5F6A7B8-C9D0-1234-EFAB-345678901234">
              <File Id="SnapshotBlob"
                    Name="snapshot_blob.bin"
                    Source="$(var.BuildDir)\snapshot_blob.bin"
                    KeyPath="yes" />
            </Component>

            <!-- Locales directory -->
            <Directory Id="LocalesDir" Name="locales">
              <Component Id="LocaleEnUs" Guid="F6A7B8C9-D0E1-2345-FABC-456789012345">
                <File Id="LocaleEnUsPak"
                      Name="en-US.pak"
                      Source="$(var.BuildDir)\locales\en-US.pak"
                      KeyPath="yes" />
              </Component>
            </Directory>

            <!-- Widevine CDM (separate component for optional install) -->
            <Directory Id="WidevineCdmDir" Name="WidevineCdm">
              <Component Id="WidevineCdm" Guid="A7B8C9D0-E1F2-3456-ABCD-567890123456">
                <File Id="WidevineCdmDll"
                      Name="widevinecdm.dll"
                      Source="$(var.BuildDir)\WidevineCdm\widevinecdm.dll"
                      KeyPath="yes" />
              </Component>
            </Directory>

          </Directory>
        </Directory>
      </Directory>

      <!-- Start Menu shortcut -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="VigoMenuFolder" Name="Vigo Browser">
          <Component Id="StartMenuShortcut" Guid="B8C9D0E1-F2A3-4567-BCDE-678901234567">
            <Shortcut Id="VigoShortcut"
                      Name="Vigo Browser"
                      Target="[INSTALLFOLDER]vigo.exe"
                      WorkingDirectory="INSTALLFOLDER"
                      Icon="vigo.ico" />
            <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
            <RegistryValue Root="HKCU"
                           Key="Software\Vigo Browser\Install"
                           Name="MenuShortcut"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <!-- Desktop shortcut -->
      <Directory Id="DesktopFolder">
        <Component Id="DesktopShortcut" Guid="C9D0E1F2-A3B4-5678-CDEF-789012345678">
          <Shortcut Id="VigoDesktopShortcut"
                    Name="Vigo Browser"
                    Target="[INSTALLFOLDER]vigo.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="vigo.ico" />
          <RegistryValue Root="HKCU"
                         Key="Software\Vigo Browser\Install"
                         Name="DesktopShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>

    </Directory>

    <!-- ── Icon ───────────────────────────────────────────── -->
    <Icon Id="vigo.ico" SourceFile="$(var.BuildDir)\vigo.ico" />

    <!-- ── Feature Tree ───────────────────────────────────── -->
    <Feature Id="MainFeature"
             Title="Vigo Browser"
             Description="Privacy-first Chromium browser with universal media support"
             Level="1"
             ConfigurableDirectory="INSTALLFOLDER"
             AllowAbsent="no">

      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ChromiumResources" />
      <ComponentRef Id="VigoResources" />
      <ComponentRef Id="IcuData" />
      <ComponentRef Id="V8Snapshot" />
      <ComponentRef Id="LocaleEnUs" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Feature Id="WidevineDrm"
             Title="Widevine DRM Support"
             Description="Enables playback of DRM-protected content (Netflix, Disney+, etc.)"
             Level="1"
             AllowAbsent="yes">
      <ComponentRef Id="WidevineCdm" />
    </Feature>

    <!-- ── UI ─────────────────────────────────────────────── -->
    <!-- Minimal UI: progress bar only for silent install.
         Full UI wizard defined in separate UI extension. -->
    <UI>
      <UIRef Id="WixUI_Minimal" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" />
    </UI>

    <!-- ── Custom Actions ─────────────────────────────────── -->
    <!-- Launch browser after install (optional). -->
    <CustomAction Id="LaunchVigo"
                  FileRef="VigoExe"
                  ExeCommand=""
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="LaunchVigo" After="InstallFinalize">
        NOT Installed AND NOT REMOVE
      </Custom>
    </InstallExecuteSequence>

  </Package>
</Wix>
