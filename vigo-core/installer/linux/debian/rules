#!/usr/bin/make -f
# Copyright (c) 2025 Vigo Browser. All rights reserved.
# Proprietary and confidential. Unauthorized copying prohibited.
#
# Debian build rules for Vigo Browser.
# This is a pre-built binary package — no compilation step.

%:
	dh $@

override_dh_auto_build:
	# Binary is pre-built by the Chromium/GN build system.
	# Nothing to compile here.

override_dh_auto_install:
	# Install main binary
	install -Dm755 $(CURDIR)/out/Release/vigo \
		$(CURDIR)/debian/vigo-browser/usr/lib/vigo-browser/vigo-browser

	# Install wrapper script
	install -Dm755 $(CURDIR)/installer/linux/vigo-browser-wrapper.sh \
		$(CURDIR)/debian/vigo-browser/usr/bin/vigo-browser

	# Install resources
	install -Dm644 $(CURDIR)/out/Release/*.pak \
		-t $(CURDIR)/debian/vigo-browser/usr/lib/vigo-browser/

	# Install locales
	install -Dm644 $(CURDIR)/out/Release/locales/*.pak \
		-t $(CURDIR)/debian/vigo-browser/usr/lib/vigo-browser/locales/

	# Install shared libraries
	for lib in $(CURDIR)/out/Release/lib*.so; do \
		[ -f "$$lib" ] && install -Dm644 "$$lib" \
			-t $(CURDIR)/debian/vigo-browser/usr/lib/vigo-browser/ || true; \
	done

	# Install .desktop file
	install -Dm644 $(CURDIR)/installer/linux/vigo-browser.desktop \
		$(CURDIR)/debian/vigo-browser/usr/share/applications/vigo-browser.desktop

	# Install icons
	for size in 16 24 32 48 64 128 256; do \
		icon="$(CURDIR)/app/icons/product_logo_$${size}.png"; \
		if [ -f "$$icon" ]; then \
			install -Dm644 "$$icon" \
				$(CURDIR)/debian/vigo-browser/usr/share/icons/hicolor/$${size}x$${size}/apps/vigo-browser.png; \
		fi \
	done

	# Install man page
	install -Dm644 $(CURDIR)/installer/linux/vigo-browser.1 \
		$(CURDIR)/debian/vigo-browser/usr/share/man/man1/vigo-browser.1 2>/dev/null || true

override_dh_shlibdeps:
	dh_shlibdeps -l$(CURDIR)/debian/vigo-browser/usr/lib/vigo-browser

override_dh_strip:
	# Don't strip pre-built binaries
	true

override_dh_auto_test:
	# Tests run separately in CI
	true
