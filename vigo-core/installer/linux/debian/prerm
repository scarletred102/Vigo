#
# Pre-removal script for Vigo Browser Debian package.
# Cleans up alternatives and caches.

set -e

# Remove browser alternatives
if command -v update-alternatives &>/dev/null; then
    update-alternatives --remove x-www-browser /usr/bin/vigo-browser 2>/dev/null || true
    update-alternatives --remove gnome-www-browser /usr/bin/vigo-browser 2>/dev/null || true
fi

exit 0
