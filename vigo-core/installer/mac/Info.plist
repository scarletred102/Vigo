<plist version="1.0">
<dict>
    <!-- Bundle Identity -->
    <key>CFBundleName</key>
    <string>Vigo</string>
    <key>CFBundleDisplayName</key>
    <string>Vigo Browser</string>
    <key>CFBundleIdentifier</key>
    <string>com.vigobrowser.vigo</string>
    <key>CFBundleExecutable</key>
    <string>Vigo</string>
    <key>CFBundleIconFile</key>
    <string>vigo.icns</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>VIGO</string>

    <!-- Versioning -->
    <key>CFBundleVersion</key>
    <string>0.1.0.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <!-- macOS Requirements -->
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>LSArchitecturePriority</key>
    <array>
        <string>arm64</string>
        <string>x86_64</string>
    </array>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- Category -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>

    <!-- Copyright -->
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2025 Vigo Browser. All rights reserved.</string>

    <!-- Document Types: web content -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>HTML Document</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.html</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>XHTML Document</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.xhtml</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>PDF Document</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.adobe.pdf</string>
            </array>
        </dict>
    </array>

    <!-- URL Schemes -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>HTTP URL</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>http</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleURLName</key>
            <string>HTTPS URL</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>https</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleURLName</key>
            <string>Vigo Protocol</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>vigo</string>
            </array>
        </dict>
    </array>

    <!-- Default Browser Registration -->
    <key>LSHandlerRank</key>
    <string>Default</string>

    <!-- Privacy: Camera/Microphone/Location -->
    <key>NSCameraUsageDescription</key>
    <string>Vigo Browser requires camera access for websites that use your camera.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Vigo Browser requires microphone access for websites that use your microphone.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Vigo Browser requires location access for websites that request your location.</string>

    <!-- Hardened Runtime -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Vigo Browser uses AppleEvents for automation and scripting.</string>

    <!-- Sparkle / Auto-Update -->
    <key>SUFeedURL</key>
    <string>https://update.vigobrowser.com/mac/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string></string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
</dict>
</plist>
