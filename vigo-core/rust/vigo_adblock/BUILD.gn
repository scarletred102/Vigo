# GN build target for the Rust vigo_adblock crate.
# Produces a static library linked into the browser process.

import("//build/rust/rust_static_library.gni")

rust_static_library("vigo_adblock_rs") {
  crate_name = "vigo_adblock"
  crate_root = "//vigo/rust/vigo_adblock/src/lib.rs"

  sources = [
    "//vigo/rust/vigo_adblock/src/engine.rs",
    "//vigo/rust/vigo_adblock/src/ffi.rs",
    "//vigo/rust/vigo_adblock/src/lib.rs",
  ]

  # Allow unsafe FFI exports.
  allow_unsafe = true
}
