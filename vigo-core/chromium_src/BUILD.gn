# chromium_src overrides — these files shadow upstream Chromium sources.
# The build system should include this directory in the source tree with
# higher priority than the upstream Chromium source, so that files here
# replace their upstream counterparts during compilation.
#
# Each file uses the #define/#undef shadow pattern to minimally alter
# upstream behaviour without forking entire files.
#
# See: vigo-core/.github/instructions/vigo-cpp.instructions.md for the
# full override pattern documentation.

source_set("chromium_src_overrides") {
  sources = [
    # Browser-level overrides.
    "chrome/browser/chrome_content_browser_client.cc",
    "chrome/browser/enterprise/reporting/chrome_reporting_client.cc",
    "chrome/browser/metrics/chrome_metrics_service_client.cc",
    "chrome/browser/promos/promo_service.cc",
    "chrome/browser/rlz/chrome_rlz_tracker_delegate.cc",
    "chrome/browser/signin/signin_manager.cc",
    "chrome/browser/translate/chrome_translate_client.cc",

    # Component-level overrides.
    "components/gcm_driver/gcm_driver.cc",
    "components/sync/service/sync_service_impl.cc",
    "components/variations/service/variations_service.cc",
  ]

  # These sources are compiled in place of the upstream originals.
  # Dependencies mirror the upstream targets they replace.
  deps = [
    "//base",
    "//chrome/browser",
    "//components/gcm_driver",
    "//components/metrics",
    "//components/sync",
    "//components/variations/service",
    "//vigo/browser:vigo_browser",
  ]

  configs += [ "//vigo/build/config:vigo_config" ]
}
