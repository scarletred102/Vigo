# Vigo build-flag variable definitions.
#
# This file re-exports the vigo_args so that any BUILD.gn that imports
# this .gni has access to the vigo_enable_* GN variables for if()
# conditions.  The actual buildflag_header() target that generates the
# C++ header lives in //vigo/build/config/BUILD.gn — depend on
# "//vigo/build/config:vigo_buildflags" to consume it.
#
# Usage in C++:
#   #include "vigo/build/config/vigo_buildflags.h"
#   #if BUILDFLAG(VIGO_ENABLE_ADBLOCK)
#     ...
#   #endif

import("//vigo/build/config/vigo_args.gni")
