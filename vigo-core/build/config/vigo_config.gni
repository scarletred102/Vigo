# Shared compiler configuration applied to all Vigo targets.

config("vigo_config") {
  defines = [ "VIGO_BROWSER" ]

  include_dirs = [
    "//vigo",
    "$root_gen_dir/vigo",
  ]
}

# Strict warnings config for Vigo-authored code (not third_party).
config("vigo_strict_warnings") {
  if (is_clang) {
    cflags = [
      "-Werror",
      "-Wall",
      "-Wextra",
      "-Wno-unused-parameter",
      "-Wthread-safety",
    ]
  }
}
