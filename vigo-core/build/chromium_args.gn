# Chromium GN args for Vigo Browser.
# Copy this file to src/out/Release/args.gn (or src/out/Debug/args.gn)
# before running `gn gen` and `autoninja`.
#
# Usage:
#   cp vigo-core/build/chromium_args.gn src/out/Release/args.gn
#   cd src
#   gn gen out/Release
#   autoninja -C out/Release chrome

# ── Identity ────────────────────────────────────────────────────
is_chrome_branded = false
is_official_build = false  # Set true for release builds

# ── Media: Play Everything ──────────────────────────────────────
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# ── Build Type ──────────────────────────────────────────────────
# Debug build — change to "Release" for production.
is_debug = true
is_component_build = true  # Faster incremental builds during dev

# ── Vigo: Wire targets into Chromium build graph ────────────────
root_extra_deps = [ "//vigo:vigo" ]

# ── Vigo Feature Flags ──────────────────────────────────────────
# These are picked up by vigo-core/build/config/vigo_args.gni
# and generate BUILDFLAG(VIGO_*) macros.

# Enable all Vigo features by default during development.
# Disable individual features to test isolation.

# ── API Keys ────────────────────────────────────────────────────
# DO NOT commit real keys here. Provide via environment variables
# or a local override file that is .gitignored.
#
# google_api_key = ""
# google_default_client_id = ""
# google_default_client_secret = ""

# ── Performance ─────────────────────────────────────────────────
# Use jumbo builds for faster compilation (if supported).
# use_jumbo_build = true

# Symbol level: 1 for debug, 0 for release size.
symbol_level = 1

# ── Platform-Specific ──────────────────────────────────────────
# Windows:
# target_os = "win"
# target_cpu = "x64"

# macOS:
# target_os = "mac"
# target_cpu = "x64"  # or "arm64" for Apple Silicon

# Linux:
# target_os = "linux"
# target_cpu = "x64"
