# Root BUILD.gn for vigo-core.
# This file is the entry point for all Vigo-specific GN targets.
# vigo-core is mounted at src/vigo/ inside the Chromium source tree.

import("//vigo/build/config/vigo_buildflags.gni")

group("vigo") {
  deps = [
    "//vigo/app:vigo_branding",
    "//vigo/browser:vigo_browser",
    "//vigo/components:vigo_components",
  ]

  # chromium_src overrides require patch-based source exclusion to avoid
  # duplicate symbols with upstream targets.  Enable once patching is set up.
  # deps += [ "//vigo/chromium_src:chromium_src_overrides" ]
}

group("vigo_tests") {
  testonly = true
  deps = [
    "//vigo/app:unit_tests",
    "//vigo/browser/net:unit_tests",
    "//vigo/browser/ui/webui:unit_tests",
    "//vigo/components:unit_tests",
    "//vigo/test:vigo_test_support",
  ]
}
