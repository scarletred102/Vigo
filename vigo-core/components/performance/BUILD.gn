import("//vigo/build/config/vigo_buildflags.gni")

source_set("performance") {
  sources = [
    "vigo_memory_budget_controller.cc",
    "vigo_memory_budget_controller.h",
    "vigo_memory_reclaimer.cc",
    "vigo_memory_reclaimer.h",
    "vigo_performance_controller.cc",
    "vigo_performance_controller.h",
    "vigo_performance_telemetry.cc",
    "vigo_performance_telemetry.h",
    "vigo_process_manager.cc",
    "vigo_process_manager.h",
    "vigo_startup_controller.cc",
    "vigo_startup_controller.h",
    "vigo_tab_lifecycle_manager.cc",
    "vigo_tab_lifecycle_manager.h",
  ]

  deps = [
    "//base",
    "//vigo/build/config:vigo_buildflags",
  ]

  configs += [ "//vigo/build/config:vigo_config" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "vigo_memory_budget_controller_unittest.cc",
    "vigo_memory_reclaimer_unittest.cc",
    "vigo_performance_controller_unittest.cc",
    "vigo_performance_telemetry_unittest.cc",
    "vigo_process_manager_unittest.cc",
    "vigo_startup_controller_unittest.cc",
    "vigo_tab_lifecycle_manager_unittest.cc",
  ]

  deps = [
    ":performance",
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}
