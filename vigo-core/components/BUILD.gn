# Aggregate target for all Vigo components.

import("//vigo/build/config/vigo_buildflags.gni")

group("vigo_components") {
  deps = []

  if (vigo_enable_adblock) {
    deps += [ "//vigo/components/adblock" ]
  }

  if (vigo_enable_privacy_engine) {
    deps += [ "//vigo/components/privacy_engine" ]
  }

  if (vigo_enable_media_orchestration) {
    deps += [ "//vigo/components/media_orchestration" ]
  }

  if (vigo_enable_sync) {
    deps += [ "//vigo/components/sync" ]
  }

  if (vigo_enable_credential_vault) {
    deps += [ "//vigo/components/credential_vault" ]
  }

  if (vigo_enable_extensions) {
    deps += [ "//vigo/components/extensions" ]
  }

  if (vigo_enable_performance) {
    deps += [ "//vigo/components/performance" ]
  }
}

group("unit_tests") {
  testonly = true
  deps = []

  if (vigo_enable_adblock) {
    deps += [ "//vigo/components/adblock:unit_tests" ]
  }

  if (vigo_enable_privacy_engine) {
    deps += [ "//vigo/components/privacy_engine:unit_tests" ]
  }

  if (vigo_enable_media_orchestration) {
    deps += [ "//vigo/components/media_orchestration:unit_tests" ]
  }

  if (vigo_enable_sync) {
    deps += [ "//vigo/components/sync:unit_tests" ]
  }

  if (vigo_enable_credential_vault) {
    deps += [ "//vigo/components/credential_vault:unit_tests" ]
  }

  if (vigo_enable_extensions) {
    deps += [ "//vigo/components/extensions:unit_tests" ]
  }

  if (vigo_enable_performance) {
    deps += [ "//vigo/components/performance:unit_tests" ]
  }
}
