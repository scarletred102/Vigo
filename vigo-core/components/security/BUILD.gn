import("//vigo/build/config/vigo_buildflags.gni")

source_set("security") {
  sources = [
    "vigo_code_signing.cc",
    "vigo_code_signing.h",
    "vigo_cve_monitor.cc",
    "vigo_cve_monitor.h",
    "vigo_license_key.cc",
    "vigo_license_key.h",
    "vigo_sbom_generator.cc",
    "vigo_sbom_generator.h",
    "vigo_security_hardening.cc",
    "vigo_security_hardening.h",
    "vigo_update_client.cc",
    "vigo_update_client.h",
  ]

  deps = [
    "//base",
    "//crypto",
    "//net",
    "//services/network/public/cpp",
    "//url",
    "//vigo/app:vigo_branding",
    "//vigo/build/config:vigo_buildflags",
  ]

  if (vigo_enable_sync) {
    deps += [ "//vigo/components/sync" ]
  }

  configs += [ "//vigo/build/config:vigo_config" ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "vigo_code_signing_unittest.cc",
    "vigo_cve_monitor_unittest.cc",
    "vigo_license_key_unittest.cc",
    "vigo_sbom_generator_unittest.cc",
    "vigo_security_hardening_unittest.cc",
    "vigo_update_client_unittest.cc",
  ]

  deps = [
    ":security",
    "//base",
    "//base/test:test_support",
    "//testing/gtest",
    "//vigo/build/config:vigo_buildflags",
  ]
}
