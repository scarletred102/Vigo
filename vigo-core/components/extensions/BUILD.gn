import("//vigo/build/config/vigo_buildflags.gni")

source_set("extensions") {
  sources = [
    "vigo_extension_manager.cc",
    "vigo_extension_manager.h",
  ]

  deps = [
    "//base",
    "//vigo/build/config:vigo_buildflags",
  ]

  configs += [ "//vigo/build/config:vigo_config" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "vigo_extension_manager_unittest.cc" ]

  deps = [
    ":extensions",
    "//testing/gtest",
  ]
}
