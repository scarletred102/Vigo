import("//vigo/build/config/vigo_buildflags.gni")

source_set("credential_vault") {
  sources = [
    "vigo_credential_vault.cc",
    "vigo_credential_vault.h",
  ]

  deps = [
    "//base",
    "//vigo/build/config:vigo_buildflags",
    "//vigo/components/sync",
  ]

  # Rust crypto FFI bridge for vault encryption.
  deps += [ "//vigo/rust/vigo_crypto:vigo_crypto_rs" ]

  configs += [ "//vigo/build/config:vigo_config" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "vigo_credential_vault_unittest.cc" ]

  deps = [
    ":credential_vault",
    "//testing/gtest",
  ]
}
