import("//vigo/build/config/vigo_buildflags.gni")

source_set("adblock") {
  sources = [
    "ffi/vigo_adblock_ffi.h",
    "vigo_adblock_service.cc",
    "vigo_adblock_service.h",
    "vigo_adblock_service_factory.cc",
    "vigo_adblock_service_factory.h",
    "vigo_filter_list_manager.cc",
    "vigo_filter_list_manager.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/profiles",
    "//components/keyed_service/content",
    "//components/keyed_service/core",
    "//net",
    "//services/network/public/cpp",
    "//url",
    "//vigo/build/config:vigo_buildflags",
    "//vigo/rust/vigo_adblock:vigo_adblock_rs",
  ]

  configs += [ "//vigo/build/config:vigo_config" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "vigo_adblock_service_factory_unittest.cc",
    "vigo_adblock_service_unittest.cc",
    "vigo_filter_list_manager_unittest.cc",
  ]

  deps = [
    ":adblock",
    "//base/test:test_support",
    "//testing/gtest",
    "//url",
  ]
}
